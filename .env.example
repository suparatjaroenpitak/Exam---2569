JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./prisma/dev.db"
PYTHON_AI_URL=http://127.0.0.1:8000
# Optional override for production when not using Render Blueprint service wiring
PYTHON_AI_PUBLIC_URL=
ALLOW_PYTHON_CLI_FALLBACK=1
ENABLE_TRANSFORMER_FALLBACK=0
TRANSFORMERS_MODEL=Qwen/Qwen2.5-1.5B-Instruct
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-in-env

# Ollama configuration (running on Google Colab or local)
# Set OLLAMA_BASE_URL to the Colab ngrok/tunnel URL + "/api"
# e.g. OLLAMA_BASE_URL=https://xxxx-xxx-xxx-xxx.ngrok-free.app/api
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma2:2b
ENABLE_OLLAMA=1
